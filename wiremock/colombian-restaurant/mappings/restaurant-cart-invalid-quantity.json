{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/restaurant/cart",
    "bodyPatterns": [
      { "matchesJsonPath": "$.items[?(@.quantity <= 0)]" }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "errors/unprocessable-entity.json"
  }
}
