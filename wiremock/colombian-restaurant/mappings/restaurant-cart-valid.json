{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/api/restaurant/cart",
    "bodyPatterns": [
      { "matchesJsonPath": "$.customer.name" },
      { "matchesJsonPath": "$.items[0]" }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "cart-created.json"
  }
}
